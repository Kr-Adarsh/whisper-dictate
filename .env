#configs:
#-> 'small.en': English & Indian English (Recommended)
#-> 'small': Multilingual one..
#-> 'turbo' / 'medium' / 'base.en' / 'tiny' as you feel fit..

WHISPER_MODEL=small #use small or above for higer accuracy..

LANGUAGE=en #'en' for English & Indian English, 'hi' for Hindi(fast-whisper is crap at this; not recc), or 'auto'

DEVICE=auto #cudo||cpu

COMPUTE_TYPE=auto #float16 on GPU, int8 on CPU for maximum speed
PAUSE_THRESHOLD_SECONDS=0.7 #pause before fnl sentence transc 
VAD_THRESHOLD=0.35 #silero vas confidence thresh(0-1)

#pre-roll and post-roll padding in seconds to prevent clipped words..
PRE_ROLL_SECONDS=0.3
POST_ROLL_SECONDS=0.3

MAX_SPEECH_DURATION=8.0 #max sec before transcribing 

TYPING_BACKEND=auto #(detects X11 vs Wayland), 'xdotool', 'ydotool', 'wtype' [Not flawless yet]

TYPING_METHOD=type #'type' (xdotool type) or 'paste' (xclip + Ctrl+V)
TYPING_DELAY_MS=1 #in ms

INITIAL_PROMPT="Hello, this is standard conversational English, including Indian English terms and natural punctuation."

SOUND_ALERTS=true #those doup! and thingg! 
TOGGLE_MODE=true #to stop: either `esc` or `same shortcut again`